{
  "name": "conceptual-obgyn",
  "version": "1.0.0",
  "private": true,
  "description": "Conceptual OBGYN — a next-generation medical education & high-yield revision PWA for NEET UG and NEET PG aspirants.",
  "workspaces": [
    "client",
    "server"
  ],
  "engines": {
    "node": ">=20.10.0"
  },
  "scripts": {
    "dev": "concurrently -n client,server -c cyan,magenta \"npm:dev:client\" \"npm:dev:server\"",
    "dev:client": "npm run dev --workspace @conceptual-obgyn/client",
    "dev:server": "npm run dev --workspace @conceptual-obgyn/server",
    "build": "npm run build --workspace @conceptual-obgyn/client && npm run build --workspace @conceptual-obgyn/server",
    "build:client": "npm run build --workspace @conceptual-obgyn/client",
    "build:server": "npm run build --workspace @conceptual-obgyn/server",
    "typecheck": "npm run typecheck --workspace @conceptual-obgyn/client && npm run typecheck --workspace @conceptual-obgyn/server",
    "preview": "npm run preview --workspace @conceptual-obgyn/client",
    "start": "npm run start --workspace @conceptual-obgyn/server",
    "icons": "npm run icons --workspace @conceptual-obgyn/client",
    "seed": "npm run seed --workspace @conceptual-obgyn/server",
    "postinstall": "npm run icons --workspace @conceptual-obgyn/client"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
