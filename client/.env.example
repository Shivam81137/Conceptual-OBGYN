# Base URL for the Conceptual OBGYN intelligence API.
# Leave as a path so the Vite dev proxy (see vite.config.ts) forwards to the Express server.
# In a production build served from a non-local host, the client defaults to
# https://conceptual-obgyn.onrender.com/api/v1 unless this variable is set.
VITE_API_BASE_URL=/api/v1

# Optional: enable the offline-first service worker while running `vite dev`.
VITE_ENABLE_SW_IN_DEV=false
