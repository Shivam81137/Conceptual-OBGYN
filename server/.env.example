# ── Runtime ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
LOG_LEVEL=debug

# ── Database ──────────────────────────────────────────────────────────────────
# Leave empty to boot the API against the in-memory seed repository:
# `mongodb://127.0.0.1:27017/conceptual_obgyn`
MONGODB_URI=mongodb://127.0.0.1:27017/conceptual_obgyn
MONGODB_CONNECT_TIMEOUT_MS=5000
MONGODB_MAX_RETRIES=5

# ── Security ──────────────────────────────────────────────────────────────────
# Comma-separated allowlist. Exact origins, wildcard subdomains
# (`https://*.vercel.app`) and `*` (public, credential-less API) are supported.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,https://*.vercel.app
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=180
JSON_BODY_LIMIT=256kb

# ── Intelligence layer (RAG) ──────────────────────────────────────────────────
AI_EMBEDDING_DIMENSIONS=384
AI_CHUNK_TOKENS=180
AI_SUMMARY_SENTENCES=6
AI_VECTOR_STORE=memory

# ── OBGYN AI Studio (provider chain + uploads) ────────────────────────────────
# Chain: OmniRoute → Gemini → OpenRouter → Groq → Pollinations → curated vault.
# Every failing provider is parked for a cooldown and the next one answers, so
# POST /ai/obgyn-assist always responds. With every key empty the studio still
# answers live via Pollinations, then falls back to the curated vault offline.
# OmniRoute is a self-hosted OpenAI-compatible gateway (default :20128) that
# auto-routes across hundreds of providers with free fallbacks. Run it with
#   npm install -g omniroute && omniroute
# then create an API key in its dashboard at http://localhost:20128.
OMNIROUTE_API_KEY=
OMNIROUTE_BASE_URL=http://localhost:20128/v1
# "auto/*" routes automatically; pin a direct provider id (e.g. agy/gemini-3.8-flash-tiered)
# to skip fallback hops when you know which upstream you want.
OMNIROUTE_MODEL=auto/best-chat
OMNIROUTE_TIMEOUT_MS=60000
# Free keys: https://aistudio.google.com/apikey  (Gemini)
#            https://openrouter.ai/keys          (open-source models, ":free" tier)
#            https://console.groq.com/keys       (GPT-OSS / Llama on LPUs)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_MS=30000
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free
OPENROUTER_TIMEOUT_MS=30000
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_MS=30000
# Keyless open-source text API (https://pollinations.ai) — set 0 to disable.
POLLINATIONS_ENABLED=1
POLLINATIONS_MODEL=openai-fast
POLLINATIONS_TIMEOUT_MS=45000
# Upload ceiling for .pdf/.txt attachments on /ai/obgyn-assist (bytes).
AI_UPLOAD_MAX_BYTES=10485760
